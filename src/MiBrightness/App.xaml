<Application x:Class="MiBrightness.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#107C41"/>
            <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#E7F6EC"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
            <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#FDEBE9"/>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="CardStyle" TargetType="ui:Card">
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Setter Property="Padding" Value="24"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>