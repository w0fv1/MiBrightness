<ui:FluentWindow x:Class="MiBrightness.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="MiBrightness"
                 Width="920"
                 Height="780"
                 MinWidth="760"
                 MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="CanResize"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,26,32,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="MiBrightness"
                                   FontSize="32"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="小爱同学 × 巴法云 × Windows 内屏亮度"
                                   Margin="0,6,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource SubtleTextBrush}"/>
                    </StackPanel>

                    <Border x:Name="StatusBadge"
                            Grid.Column="1"
                            CornerRadius="8"
                            Padding="14,8"
                            VerticalAlignment="Center"
                            Background="{StaticResource SuccessBackgroundBrush}">
                        <TextBlock x:Name="StatusText"
                                   Text="● 正在启动"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </Border>
                </Grid>

                <ui:Card Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="连接"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="巴法 Topic"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TopicBox"
                                         MinHeight="38"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="直连网卡"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="InterfaceBox"
                                          MinHeight="38"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="EndpointText"
                                           Text="尚未建立连接"
                                           FontSize="13"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ErrorText"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource DangerBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="重新连接"
                                    Margin="16,0,0,0"
                                    Padding="16,8"
                                    Click="Reconnect_Click"/>
                        </Grid>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="屏幕亮度"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0"/>

                            <TextBlock x:Name="BrightnessText"
                                       Grid.Column="1"
                                       Text="--%"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Grid>

                        <Slider x:Name="BrightnessSlider"
                                Grid.Row="1"
                                Margin="0,18,0,0"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="10"
                                IsSnapToTickEnabled="False"
                                ValueChanged="BrightnessSlider_ValueChanged"/>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TestValueText"
                                       Text="测试值：--%"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SubtleTextBrush}"/>

                            <Button Grid.Column="1"
                                    Content="应用测试亮度"
                                    Padding="18,8"
                                    Click="TestBrightness_Click"/>
                        </Grid>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Row="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="高级设置"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="心跳间隔（秒）"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <ui:NumberBox x:Name="HeartbeatBox"
                                              Minimum="10"
                                              Maximum="300"
                                              MinHeight="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="默认亮度"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <ui:NumberBox x:Name="DefaultBrightnessBox"
                                              Minimum="1"
                                              Maximum="100"
                                              MinHeight="38"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,20,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="登录 Windows 后自动启动"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="使用当前用户的计划任务启动，不需要管理员权限"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource SubtleTextBrush}"/>
                            </StackPanel>

                            <ui:ToggleSwitch x:Name="AutoStartToggle"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Margin="0,20,0,18"/>

                        <WrapPanel>
                            <Button Content="设置巴法私钥"
                                    Padding="16,8"
                                    Margin="0,0,10,10"
                                    Click="SetSecret_Click"/>
                            <Button Content="打开 config.json"
                                    Padding="16,8"
                                    Margin="0,0,10,10"
                                    Click="OpenConfig_Click"/>
                            <Button Content="打开日志目录"
                                    Padding="16,8"
                                    Margin="0,0,10,10"
                                    Click="OpenLogs_Click"/>
                        </WrapPanel>

                        <TextBlock Text="私钥使用 Windows DPAPI 加密，仅当前 Windows 用户可解密。"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource SubtleTextBrush}"/>
                    </StackPanel>
                </ui:Card>

                <Grid Grid.Row="4" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SaveHintText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource SubtleTextBrush}"
                               Text="配置保存后会自动重新连接。"/>

                    <Button Grid.Column="1"
                            Content="关闭"
                            MinWidth="88"
                            Padding="18,9"
                            Click="Close_Click"/>

                    <ui:Button Grid.Column="3"
                               Content="保存并重新连接"
                               MinWidth="148"
                               Padding="18,9"
                               Appearance="Primary"
                               Click="Save_Click"/>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>